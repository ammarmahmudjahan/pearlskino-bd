========================================================= */

async function postApi(
  payload
) {

  const session =
    getAdminSession();


  const requestPayload = {

    ...payload,

  };


  if (
    payload.action !==
      "login" &&
    session?.token
  ) {

    requestPayload.token =
      session.token;

  }


  const response =
    await fetch(
      ORDERS_API,
      {

        method: "POST",

        headers: {
          "Content-Type":
            "text/plain;charset=utf-8",
        },

        body:
          JSON.stringify(
            requestPayload
          ),

      }
    );


  if (!response.ok) {

    throw new Error(
      "Unable to communicate with the PearlSkino API."
    );

  }


  const data =
    await response.json();


  if (!data.success) {

    if (
      data.authenticated ===
      false
    ) {

      clearAdminSession();

    }


    throw new Error(
      data.error ||
        "API request failed."
    );

  }


  return data;

}


