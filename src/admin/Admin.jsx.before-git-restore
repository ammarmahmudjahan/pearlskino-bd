              e.preventDefault();
              setActivePage(
                "products"
              );
            }}
          >
            Products
          </a>


          <a
            href="#orders"
            className={
              activePage === "orders"
                ? "active"
                : ""
            }
            onClick={(e) => {
              e.preventDefault();
              setActivePage(
                "orders"
              );
            }}
          >
            Orders

            {orders.length > 0 && (
              <span className="sidebar-count">
                {orders.length}
              </span>
            )}

          </a>


          <a
            href="#customers"
            className={
              activePage === "customers"
                ? "active"
                : ""
            }
            onClick={(e) => {
              e.preventDefault();
              setActivePage(
                "customers"
              );
            }}
          >
            Customers
          </a>


          <a
            href="#settings"
            className={
              activePage === "settings"
                ? "active"
                : ""
            }
            onClick={(e) => {
              e.preventDefault();
              setActivePage(
                "settings"
              );
            }}
          >
            Settings
          </a>


          <a
            href="#security"
            className={
              activePage === "security"
                ? "active"
                : ""
            }
            onClick={(e) => {
              e.preventDefault();
              setActivePage(
                "security"
              );
            }}
          >
            Security
          </a>

        </nav>


        <div className="admin-sidebar-bottom">

          <a href="/">
            View Store
          </a>

          <button
            type="button"
            onClick={handleLogout}
            className="admin-logout-button"
          >
            Logout
          </button>

        </div>

      </aside>


      <main className="admin-main">

        <header className="admin-topbar">

          <div>

            <p className="admin-eyebrow">
              PEARLSKINO BD
            </p>

            <h1>
              {pageTitle}
            </h1>

          </div>


          <div className="admin-topbar-actions">

            <a
              href="/"
              className="admin-view-store"
            >
              View Store
            </a>

            <button
              type="button"
              className="admin-logout-button"
              onClick={
                handleLogout
              }
            >
              Logout
            </button>

          </div>

        </header>


        {activePage === "dashboard" && (

          <>

            <Dashboard
              products={products}
              productsLoading={
                productsLoading
              }
              orders={orders}
            />

            <section className="admin-products">

              <div className="admin-section-header">

                <div>

                  <p className="admin-eyebrow">
                    CATALOG
                  </p>

                  <h2>
                    Manage Products
                  </h2>

                </div>

              </div>

              <ProductManager />

            </section>

          </>

        )}


        {activePage === "products" && (

          <section className="admin-products">

            <div className="admin-section-header">

              <div>

                <p className="admin-eyebrow">
                  CATALOG
                </p>

                <h2>
                  Manage Products
                </h2>

              </div>

            </div>

            <ProductManager />

          </section>

        )}


        {activePage === "orders" && (

          <OrdersPage
            orders={orders}
            loading={ordersLoading}
            error={ordersError}
            refreshOrders={
              refreshOrders
            }
          />

        )}


        {activePage === "customers" && (

          <CustomersPage
            customers={customers}
            loading={
              customersLoading
            }
            error={customersError}
            refreshCustomers={
              refreshCustomers
            }
          />

        )}


        {activePage === "settings" && (

          <SettingsPage />

        )}


        {activePage === "security" && (

          <ChangePasswordPage />

        )}

      </main>

    </div>

  );
}






