========================================================= */

async function loginAdmin(
  password
) {

  const data =
    await postApi({

      action:
        "login",

      password,

    });


  if (
    !data.token
  ) {

    throw new Error(
      "Login succeeded but no admin session token was returned."
    );

  }


  saveAdminSession({

    token:
      data.token,

    expiresAt:
      data.expiresAt,

  });


  return data;

}


