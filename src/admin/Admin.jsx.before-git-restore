          await checkAdminSession();

        setAuthenticated(
          loggedIn
        );

        if (!loggedIn) {
          clearAdminSession();
        }

      } finally {

        setCheckingAuth(false);

      }

    }

    verifySession();

  }, []);


  /* =======================================================
     LOAD ORDERS
  ======================================================= */

  async function refreshOrders() {

    try {

      setOrdersLoading(true);
      setOrdersError("");

      const data =
        await fetchOrders();

      setOrders(data);

    } catch (error) {

      console.error(
        "ORDERS LOADING FAILED:",
        error
      );

      if (
        error.message ===
        "Authentication required."
      ) {
        setAuthenticated(false);
        clearAdminSession();
      }

      setOrdersError(
        error.message ||
          "Unable to load orders."
      );

    } finally {

      setOrdersLoading(false);

    }

  }


