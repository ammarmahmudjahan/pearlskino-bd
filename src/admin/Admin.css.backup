.admin {
  min-height: 100vh;
  display: flex;
  background: #f9f5ef;
  color: #3d3541;
}

.admin-sidebar {
  width: 245px;
  min-height: 100vh;
  padding: 30px 22px;
  background: #302936;
  color: white;
  display: flex;
  flex-direction: column;
}

.admin-brand {
  font-family: Georgia, serif;
  font-size: 23px;
  margin-bottom: 55px;
}

.admin-brand span {
  color: #d9c5df;
  font-family: Arial, sans-serif;
  font-size: 11px;
  letter-spacing: 2px;
}

.admin-sidebar nav {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.admin-sidebar a {
  padding: 13px 15px;
  border-radius: 10px;
  color: #cfc5d2;
  text-decoration: none;
  font-size: 14px;
  cursor: pointer;
}

.admin-sidebar a:hover,
.admin-sidebar a.active {
  background: rgba(255, 255, 255, 0.09);
  color: white;
}

.admin-sidebar-bottom {
  margin-top: auto;
}

.admin-main {
  flex: 1;
  padding: 45px 5%;
  overflow: hidden;
}

.admin-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 40px;
}

.admin-eyebrow {
  margin: 0 0 8px;
  color: #9c82aa;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 3px;
}

.admin-topbar h1 {
  margin: 0;
  font-family: Georgia, serif;
  font-size: 48px;
  font-weight: 400;
  letter-spacing: -1px;
}

.admin-view-store,
.add-product-button {
  border: 0;
  border-radius: 999px;
  padding: 12px 20px;
  background: #9c82aa;
  color: white;
  cursor: pointer;
  transition: 0.25s ease;
}

.admin-view-store:hover,
.add-product-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(100, 75, 110, 0.2);
}

.admin-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 18px;
  margin-bottom: 45px;
}

.admin-stat {
  padding: 25px;
  border: 1px solid rgba(100, 80, 110, 0.1);
  border-radius: 18px;
  background: rgba(255, 255, 255, 0.7);
}

.admin-stat span {
  display: block;
  color: #817682;
  font-size: 13px;
  margin-bottom: 14px;
}

.admin-stat strong {
  font-family: Georgia, serif;
  font-size: 34px;
  font-weight: 400;
}

.admin-section-header {
  display: flex;
  justify-content: space-between;
  align-items: end;
  margin-bottom: 20px;
}

.admin-section-header h2 {
  margin: 0;
  font-family: Georgia, serif;
  font-size: 32px;
  font-weight: 400;
}

.admin-product-table {
  overflow: hidden;
  border: 1px solid rgba(100, 80, 110, 0.1);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.72);
}

.admin-table-header {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 1fr 1fr 0.8fr;
  padding: 17px 22px;
  border-bottom: 1px solid rgba(100, 80, 110, 0.1);
  color: #817682;
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.admin-empty {
  padding: 90px 20px;
  text-align: center;
}

.admin-empty-icon {
  width: 65px;
  height: 65px;
  margin: auto;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #eee5f0;
  color: #9c82aa;
  font-size: 25px;
}

.admin-empty h3 {
  margin: 22px 0 8px;
  font-family: Georgia, serif;
  font-size: 24px;
  font-weight: 400;
}

.admin-empty p {
  max-width: 420px;
  margin: 0 auto 25px;
  color: #817682;
  line-height: 1.7;
  font-size: 14px;
}

@media (max-width: 900px) {
  .admin-sidebar {
    width: 190px;
  }

  .admin-stats {
    grid-template-columns: repeat(2, 1fr);
  }

  .admin-table-header {
    display: none;
  }
}

@media (max-width: 650px) {
  .admin-sidebar {
    display: none;
  }

  .admin-main {
    padding: 30px 20px;
  }

  .admin-topbar h1 {
    font-size: 38px;
  }

  .admin-stats {
    grid-template-columns: 1fr 1fr;
  }
}
.product-manager-toolbar {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  margin-bottom: 20px;
}

.product-manager-toolbar input {
  flex: 1;
  padding: 13px 16px;
  border: 1px solid #ddd;
  border-radius: 10px;
  font-size: 14px;
}

.admin-product-row {
  display: grid;
  grid-template-columns: 2fr 1fr 1fr 0.7fr 0.9fr 1.4fr;
  align-items: center;
  gap: 15px;
  padding: 16px 20px;
  border-top: 1px solid #eee;
}

.admin-product-name {
  display: flex;
  align-items: center;
  gap: 12px;
}

.admin-product-name img {
  width: 48px;
  height: 48px;
  object-fit: cover;
  border-radius: 8px;
}

.admin-product-name strong {
  display: block;
}

.admin-product-name small {
  display: block;
  margin-top: 3px;
  opacity: 0.6;
}

.admin-product-actions {
  display: flex;
  gap: 8px;
}

.admin-product-actions button {
  border: 1px solid #ddd;
  background: white;
  padding: 7px 12px;
  border-radius: 7px;
  cursor: pointer;
}

.admin-product-actions button:hover {
  background: #f5f1f7;
}

.admin-product-actions .delete-button {
  color: #b42318;
}

.status {
  display: inline-block;
  padding: 5px 9px;
  border-radius: 20px;
  font-size: 12px;
}

.status.active {
  background: #e8f7ed;
  color: #18743b;
}

.status.inactive {
  background: #f1f1f1;
  color: #777;
}

.product-editor-overlay {
  position: fixed;
  inset: 0;
  background: rgba(20, 15, 25, 0.45);
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30px;
  z-index: 9999;
}

.product-editor {
  width: min(700px, 100%);
  max-height: 90vh;
  overflow-y: auto;
  background: white;
  border-radius: 18px;
  padding: 28px;
  box-shadow: 0 25px 80px rgba(0, 0, 0, 0.2);
}

.product-editor-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 25px;
}

.product-editor-header > button {
  border: none;
  background: transparent;
  font-size: 28px;
  cursor: pointer;
}

.product-editor form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.product-editor label {
  display: flex;
  flex-direction: column;
  gap: 7px;
  font-size: 13px;
  font-weight: 600;
}

.product-editor input,
.product-editor select,
.product-editor textarea {
  width: 100%;
  box-sizing: border-box;
  padding: 12px 14px;
  border: 1px solid #ddd;
  border-radius: 9px;
  font: inherit;
  font-weight: 400;
}

.editor-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16px;
}

.product-editor-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10px;
  margin-top: 8px;
}

.product-editor-actions button {
  padding: 11px 18px;
  border: 1px solid #ddd;
  background: white;
  border-radius: 9px;
  cursor: pointer;
}

.product-editor-actions .save-product-button {
  border: none;
  background: #222;
  color: white;
}

.product-editor-actions .save-product-button:hover {
  opacity: 0.85;
}

@media (max-width: 900px) {
  .admin-product-row {
    grid-template-columns: 1fr;
    gap: 8px;
  }

  .admin-table-header {
    display: none;
  }

  .editor-grid {
    grid-template-columns: 1fr;
  }
}
/* ================================
   DRAG & DROP
================================ */

.product-position {
  display: flex;
  align-items: center;
  gap: 12px;
}

.drag-handle {
  border: 0;
  background: transparent;
  cursor: grab;
  font-size: 18px;
  letter-spacing: -4px;
  padding: 6px 10px;
  opacity: 0.55;
}

.drag-handle:hover {
  opacity: 1;
  transform: scale(1.08);
}

.drag-handle:active {
  cursor: grabbing;
}

.admin-product-row {
  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    opacity 180ms ease;
}

.admin-product-row.is-dragging {
  box-shadow:
    0 18px 45px rgba(80, 60, 100, 0.16);
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.96);
}
/* =========================================================
   ADMIN NAVIGATION
========================================================= */

.admin-sidebar nav a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.sidebar-count {
  min-width: 20px;
  height: 20px;
  padding: 0 6px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #9c82aa;
  color: white;
  font-size: 10px;
  font-weight: 700;
}


/* =========================================================
   PAGE
========================================================= */

.admin-page-section {
  width: 100%;
}

.admin-page-description {
  margin: 8px 0 0;
  color: #817682;
  font-size: 14px;
  line-height: 1.6;
}

.admin-refresh-button {
  border: 1px solid rgba(100, 80, 110, 0.15);
  border-radius: 999px;
  padding: 11px 18px;
  background: white;
  color: #3d3541;
  cursor: pointer;
  transition: 0.2s ease;
}

.admin-refresh-button:hover {
  background: #f5f0f7;
  transform: translateY(-1px);
}

.admin-refresh-button:disabled {
  opacity: 0.55;
  cursor: wait;
  transform: none;
}

.admin-loading {
  padding: 70px 20px;
  text-align: center;
  color: #817682;
}

.admin-error {
  margin-bottom: 20px;
  padding: 15px 18px;
  border: 1px solid #f0c7c7;
  border-radius: 12px;
  background: #fff4f4;
  color: #9d2929;
  font-size: 14px;
}


/* =========================================================
   DASHBOARD EXTRA
========================================================= */

.admin-dashboard-extra {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-bottom: 45px;
}


/* =========================================================
   ORDERS
========================================================= */

.orders-table-wrapper,
.customers-table-wrapper {
  width: 100%;
  overflow-x: auto;
  border: 1px solid rgba(100, 80, 110, 0.1);
  border-radius: 20px;
  background: rgba(255, 255, 255, 0.72);
}

.orders-table,
.customers-table {
  min-width: 1100px;
}

.orders-table-header,
.order-row {
  display: grid;
  grid-template-columns:
    1.1fr
    1.2fr
    1.6fr
    0.8fr
    0.9fr
    1fr
    1.3fr;
  gap: 15px;
  align-items: center;
}

.orders-table-header {
  padding: 16px 20px;
  border-bottom: 1px solid #eee;
  color: #817682;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.order-row {
  padding: 18px 20px;
  border-bottom: 1px solid #eee;
  font-size: 13px;
}

.order-row:last-child {
  border-bottom: 0;
}

.order-row strong {
  display: block;
  color: #3d3541;
}

.order-row small {
  display: block;
  margin-top: 4px;
  color: #817682;
  font-size: 11px;
  line-height: 1.4;
}

.order-id-cell strong {
  color: #8b6f9a;
}

.order-products-cell span {
  display: block;
  line-height: 1.5;
}

.order-products-cell small {
  margin-top: 5px;
}

.order-status-cell {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-start;
}

.order-status-cell select {
  width: 100%;
  min-width: 120px;
  padding: 7px 9px;
  border: 1px solid #ddd;
  border-radius: 8px;
  background: white;
  color: #3d3541;
  font-size: 12px;
}

.order-status {
  display: inline-flex;
  align-items: center;
  padding: 5px 9px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 700;
  white-space: nowrap;
}

.status-new {
  background: #eee5f7;
  color: #76528a;
}

.status-confirmed {
  background: #e7f2ff;
  color: #32699a;
}

.status-processing {
  background: #fff2d9;
  color: #986a18;
}

.status-shipped {
  background: #e5f5f2;
  color: #23776a;
}

.status-delivered {
  background: #e5f6e9;
  color: #28783f;
}

.status-cancelled {
  background: #fbe7e7;
  color: #a83b3b;
}


/* =========================================================
   CUSTOMERS
========================================================= */

.customers-table {
  min-width: 950px;
}

.customers-table-header,
.customer-row {
  display: grid;
  grid-template-columns:
    1.3fr
    1.3fr
    1.4fr
    0.7fr
    1fr
    1.1fr;
  gap: 18px;
  align-items: center;
}

.customers-table-header {
  padding: 16px 20px;
  border-bottom: 1px solid #eee;
  color: #817682;
  font-size: 10px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 1px;
}

.customer-row {
  padding: 18px 20px;
  border-bottom: 1px solid #eee;
  font-size: 13px;
}

.customer-row:last-child {
  border-bottom: 0;
}

.customer-row strong {
  display: block;
}

.customer-row small {
  display: block;
  margin-top: 4px;
  color: #817682;
  font-size: 11px;
  line-height: 1.4;
}


/* =========================================================
   RESPONSIVE
========================================================= */

@media (max-width: 900px) {

  .admin-dashboard-extra {
    grid-template-columns: 1fr;
  }

  .admin-section-header {
    align-items: flex-start;
    gap: 15px;
  }

}

@media (max-width: 650px) {

  .admin-section-header {
    flex-direction: column;
  }

  .admin-refresh-button {
    width: 100%;
  }

}
